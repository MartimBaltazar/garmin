# Copy to .env and fill in. NEVER commit the filled-in file.

# --- Credentials: needed only for the one-off `garmin-exporter login` -------
# The CronJob resumes from the token file and needs neither of these.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Token store ------------------------------------------------------------
# Holds garmin_tokens.json (a refresh token: treat it as a password) plus
# exporter-state.json (last successful run, used by the staleness alert).
GARMIN_TOKENSTORE=./.tokens

# --- Emission ---------------------------------------------------------------
# otlp | vm | both | none
#   otlp = live path, through the OTel Collector
#   vm   = direct import with explicit timestamps (backfill always uses this)
GARMIN_EMIT=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
GARMIN_VM_URL=http://localhost:8428

# --- Behaviour --------------------------------------------------------------
# Refetch a trailing window to absorb late watch syncs.
GARMIN_LOOKBACK_DAYS=2
# Rate-limit guard: minimum seconds between Garmin API calls.
GARMIN_REQUEST_PAUSE_SECONDS=1.0
LOG_LEVEL=INFO
